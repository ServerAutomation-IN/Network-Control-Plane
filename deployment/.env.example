# ==============================================================================
# Network Control Plane — Environment Configuration Template
# ==============================================================================
# ⚠️ SECURITY NOTICE:
# 1. DO NOT commit actual secrets or production credentials to source control.
# 2. Copy this template to .env:
#      cp deployment/.env.example deployment/.env
# 3. Restrict filesystem permissions immediately to protect sensitive credentials:
#      • Linux / macOS:
#          chmod 600 deployment/.env
#      • Windows (PowerShell):
#          icacls deployment\.env /inheritance:r /grant:r "$($env:USERNAME):(R,W)"
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Platform Security Settings
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 32+ character random string:
#   openssl rand -hex 32   (Linux/macOS)
#   -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 32 | ForEach-Object {[char]$_}) (PowerShell)
SECRET_KEY=replace-with-a-cryptographically-secure-32-byte-secret-key-here

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Shared bearer token for authenticating network-control-plane-agent heartbeats and telemetry (Optional)
# AGENT_API_TOKEN=replace-with-secure-agent-auth-token

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL 16) Configuration
# ------------------------------------------------------------------------------
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-db-password-123!
POSTGRES_DB=network_control_plane

# Optional full Async SQLAlchemy connection URI (overrides individual POSTGRES_* vars)
# DATABASE_URL=postgresql+asyncpg://postgres:replace-with-strong-db-password-123!@postgres:5432/network_control_plane

# ------------------------------------------------------------------------------
# 3. Redis In-Memory Cache & Async Queue Broker
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. Enterprise Okta SSO / OIDC Configuration
# ------------------------------------------------------------------------------
# Obtain these from your Okta Admin Console (Security > API > Authorization Servers
# and Applications > Network Control Plane Web App):
OKTA_ISSUER_URL=https://<your-okta-domain>.okta.com/oauth2/default
OKTA_CLIENT_ID=<your-okta-client-id>

# Secure Okta Client Secret:
# Option A (Standard): Plaintext secret stored in this file with 600 / ACL permissions:
OKTA_CLIENT_SECRET=<your-okta-client-secret>

# Option B (Enterprise Zero-Trust): Dynamic Secret URI reference fetched at runtime
# from HashiCorp Vault, AWS Secrets Manager, or Azure Key Vault:
# OKTA_CLIENT_SECRET=vault://secret/data/sso#client_secret
# OKTA_CLIENT_SECRET=aws-secret://prod/sso/okta#client_secret
# OKTA_CLIENT_SECRET=azure-vault://ncp-okta-client-secret

# JWT Claim name containing user roles/groups (default: roles)
OKTA_ROLE_CLAIM=roles

# ------------------------------------------------------------------------------
# 5. Enterprise Key Vault & Secrets Manager (Optional)
# ------------------------------------------------------------------------------
# HashiCorp Vault Integration
VAULT_ADDR=http://vault.internal:8200
VAULT_TOKEN=hvs.replace-with-your-vault-token-or-app-role

# AWS Secrets Manager & Cloud VPC Integration
AWS_REGION=us-east-1

# Azure Key Vault Integration
AZURE_KEYVAULT_URL=https://<your-vault-name>.vault.azure.net/

# ------------------------------------------------------------------------------
# 6. Local AI Assistant & LLM Integration (Optional)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ------------------------------------------------------------------------------
# 7. System Root Administrator Settings
# ------------------------------------------------------------------------------
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_EMAIL=admin@network-control-plane.local
